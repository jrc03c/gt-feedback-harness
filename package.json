{
  "name": "gt-feedback-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embed a GuidedTrack program, annotate screenshots, and send feedback to the developer.",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "test": "npm run build && npm run test:unit && node --test --test-concurrency=1 \"test/browser/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:browser": "npm run build && node --test --test-concurrency=1 \"test/browser/**/*.test.js\"",
    "test:db": "node scripts/run-pgtap.mjs supabase/tests",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "modern-screenshot": "^4.7.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.0",
    "pg": "^8.23.1",
    "prettier": "^3.3.3"
  }
}
